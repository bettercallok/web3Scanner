# ============================================================
# Web3 Security Scanner — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Django
DJANGO_SECRET_KEY=your-secret-key-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (default: SQLite; set to postgres:// for production)
DATABASE_URL=sqlite:///db.sqlite3

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Etherscan API Key — https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Tenderly (honeypot simulation) — https://dashboard.tenderly.co
TENDERLY_ACCESS_KEY=your_tenderly_access_key_here
TENDERLY_PROJECT=your_project_slug
TENDERLY_ACCOUNT=your_account_slug

# Ollama (open-source LLM — runs locally via Docker)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=codellama:7b

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Public URL of the frontend (used in alert links) and allowed browser origins.
# CORS_ALLOWED_ORIGINS also controls which sites may open progress websockets.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CSRF_TRUSTED_ORIGINS=https://your-frontend.example

# Machine-to-machine API key (X-API-Key). Leave empty to disable.
API_SECRET_KEY=

# Auth tokens (minutes / days)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Rate limits (DRF format, e.g. 50/hour)
# THROTTLE_SCANS=50/hour
# THROTTLE_CHAT=30/hour
# THROTTLE_AUTH=10/minute

# Cache backend: "redis" (default, uses REDIS_URL) or "locmem" (tests/dev)
# CACHE_BACKEND=redis

# Optional private RPC endpoints (recommended; public nodes are rate limited)
# RPC_URL_MAINNET=https://eth-mainnet.example/v2/KEY
# RPC_URL_POLYGON=
# RPC_URL_BSC=
# RPC_URL_ARBITRUM=
# RPC_URL_OPTIMISM=

# Real-time on-chain monitor (websocket RPC). Leave empty to disable.
ETH_WSS_URL=

# Alerts
TELEGRAM_BOT_TOKEN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=alerts@web3scanner.local

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
